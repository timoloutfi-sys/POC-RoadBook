<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Haut : consigne et jauge de sourire -->
    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="56dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingTop="14dp"
            android:paddingEnd="28dp"
            android:paddingBottom="14dp"
            android:text="@string/smile"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/meter"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="220dp"
            android:layout_height="12dp"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/meter" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:shadowColor="#CC000000"
            android:shadowRadius="6"
            android:text="@string/hint"
            android:textColor="#E6FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Bas : dernière photo, déclencheur manuel, compteur -->
    <FrameLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="40dp">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/thumb_frame"
            android:clipToOutline="true"
            android:contentDescription="@string/last_photo"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:visibility="invisible" />

        <ImageButton
            android:id="@+id/shutter"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:background="@drawable/shutter"
            android:contentDescription="@string/shutter" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:shadowColor="#CC000000"
            android:shadowRadius="6"
            android:textColor="@android:color/white"
            android:textSize="15sp" />
    </FrameLayout>

    <!-- Éclair blanc au déclenchement -->
    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/white"
        android:clickable="false" />

    <!-- Demande d'autorisation -->
    <LinearLayout
        android:id="@+id/permission"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="😊"
            android:textSize="72sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/permission_needed"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/grant"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/button"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/grant"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
